{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "pack": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint:eslint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "exclude": [
        "packages/eslint-config/**/*"
      ],
      "options": {
        "testMode": "run",
        "testTargetName": "test:vitest"
      }
    }
  ],
  "release": {
    "groups": {
      "esl": {
        "projects": [
          "esl"
        ],
        "releaseTag": {
          "pattern": "esl@{version}"
        }
      },
      "eslint-config": {
        "projects": [
          "eslint-config"
        ],
        "releaseTag": {
          "pattern": "eslint-config-esl@{version}"
        }
      },
      "stylelint-config": {
        "projects": [
          "stylelint-config"
        ],
        "releaseTag": {
          "pattern": "stylelint-config-esl@{version}"
        }
      },
      "uip": {
        "projects": [
          "uip"
        ],
        "releaseTag": {
          "pattern": "uip@{version}"
        }
      },
      "website": {
        "projects": [
          "esl-website",
          "esl-website-e2e",
          "esl-website-monitoring"
        ],
        "releaseTag": {
          "pattern": "esl-website@{version}"
        }
      }
    },
    "git": {
      "commit": false,
      "tag": false,
      "push": false
    },
    "version": {
      "updateDependents": "auto",
      "preserveMatchingDependencyRanges": false,
      "currentVersionResolver": "git-tag",
      "specifierSource": "conventional-commits"
    },
    "changelog": {
      "automaticFromRef": true,
      "projectChangelogs": {
        "renderOptions": {
          "authors": false
        }
      },
      "workspaceChangelog": {
        "renderOptions": {
          "authors": false
        }
      }
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "chore": {
          "releaseType": "patch",
          "changelog": false
        },
        "refactor": {
          "releaseType": "patch"
        },
        "docs": {
          "changelog": {
            "title": "Documentation updates"
          }
        }
      }
    }
  },
  "analytics": false
}
